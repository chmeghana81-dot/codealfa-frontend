import React, { useEffect, useState } from "react";
import "./AdminDashboard.css";

const API_BASE = "https://{apiUrl}/api";

function AdminDashboard() {
  const [activePage, setActivePage] = useState("Dashboard");
  const [products, setProducts] = useState([]);
  const [categories, setCategories] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");
  const [search, setSearch] = useState("");

  useEffect(() => {
    const fetchDashboardData = async () => {
      try {
        setLoading(true);
        setError("");

        const [productResponse, categoryResponse] = await Promise.all([
          fetch(`${API_BASE}/products/`),
          fetch(`${API_BASE}/categories/`),
        ]);

        if (!productResponse.ok || !categoryResponse.ok) {
          throw new Error("Unable to fetch dashboard data.");
        }

        const productData = await productResponse.json();
        const categoryData = await categoryResponse.json();

        setProducts(Array.isArray(productData) ? productData : productData.results || []);
        setCategories(Array.isArray(categoryData) ? categoryData : categoryData.results || []);
      } catch (err) {
        setError(err.message || "Backend connection failed.");
      } finally {
        setLoading(false);
      }
    };

    fetchDashboardData();
  }, []);

  const totalProducts = products.length;

  const totalStock = products.reduce(
    (total, product) => total + Number(product.stock || 0),
    0
  );

  const totalInventoryValue = products.reduce(
    (total, product) =>
      total + Number(product.price || 0) * Number(product.stock || 0),
    0
  );

  const lowStockProducts = products.filter(
    (product) => Number(product.stock) <= 12
  );

  const filteredProducts = products.filter((product) =>
    product.name.toLowerCase().includes(search.toLowerCase())
  );

  const menuItems = [
    "Dashboard",
    "Products",
    "Categories",
  ];

  const renderProducts = (items) => (
    <div className="table-wrapper">
      <table className="admin-table">
        <thead>
          <tr>
            <th>Image</th>
            <th>Product Name</th>
            <th>Category</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Status</th>
          </tr>
        </thead>

        <tbody>
          {items.length > 0 ? (
            items.map((product) => (
              <tr key={product.id}>
                <td>
                  {product.image ? (
                    <img
                      src={product.image}
                      alt={product.name}
                      style={{
                        width: "48px",
                        height: "48px",
                        objectFit: "cover",
                        borderRadius: "6px",
                      }}
                    />
                  ) : (
                    "No Image"
                  )}
                </td>
                <td>{product.name}</td>
                <td>{product.category_name}</td>
                <td>₹{Number(product.price).toLocaleString("en-IN")}</td>
                <td>{product.stock}</td>
                <td>
                  <span
                    className={`status ${
                      product.stock > 0 ? "delivered" : "cancelled"
                    }`}
                  >
                    {product.stock > 0 ? "In Stock" : "Out of Stock"}
                  </span>
                </td>
              </tr>
            ))
          ) : (
            <tr>
              <td colSpan="6">No products found.</td>
            </tr>
          )}
        </tbody>
      </table>
    </div>
  );

  if (loading) {
    return <div className="admin-main">Loading Admin Dashboard...</div>;
  }

  if (error) {
    return (
      <div className="admin-main">
        <h2>Dashboard Connection Error</h2>
        <p>{error}</p>
        <button
          className="gold-btn"
          onClick={() => window.location.reload()}
        >
          Retry
        </button>
      </div>
    );
  }

  return (
    <div className="admin-layout">
      <aside className="admin-sidebar">
        <h2 className="admin-logo">
          Mega<span>Store</span>
        </h2>

        <p className="admin-label">ADMIN PANEL</p>

        <nav>
          {menuItems.map((item) => (
            <button
              key={item}
              className={`admin-nav-item ${
                activePage === item ? "active" : ""
              }`}
              onClick={() => {
                setActivePage(item);
                setSearch("");
              }}
            >
              {item}
            </button>
          ))}
        </nav>

        <div className="sidebar-bottom">
          <p>MEGASTORE ADMIN</p>
          <small>Management Console</small>
        </div>
      </aside>

      <main className="admin-main">
        <header className="admin-topbar">
          <div>
            <h1>{activePage} Overview</h1>
            <p>Manage your MegaStore application.</p>
          </div>

          <div className="admin-profile">
            <span>Admin</span>
            <div className="admin-avatar">A</div>
          </div>
        </header>

        {activePage === "Dashboard" && (
          <>
            <div className="admin-stats">
              <div className="stat-card">
                <span className="stat-icon">□</span>
                <p>Total Products</p>
                <h2>{totalProducts}</h2>
                <small>From Django database</small>
              </div>

              <div className="stat-card">
                <span className="stat-icon">▤</span>
                <p>Total Categories</p>
                <h2>{categories.length}</h2>
                <small>Available categories</small>
              </div>

              <div className="stat-card">
                <span className="stat-icon">▥</span>
                <p>Total Stock</p>
                <h2>{totalStock}</h2>
                <small>Available inventory units</small>
              </div>

              <div className="stat-card">
                <span className="stat-icon">₹</span>
                <p>Inventory Value</p>
                <h2>
                  ₹{totalInventoryValue.toLocaleString("en-IN", {
                    maximumFractionDigits: 2,
                  })}
                </h2>
                <small>Price × stock</small>
              </div>
            </div>

            <div className="admin-panel">
              <div className="panel-heading">
                <h3>Recent Products</h3>
                <button onClick={() => setActivePage("Products")}>
                  View All
                </button>
              </div>

              {renderProducts(products.slice(0, 5))}
            </div>

            <div className="admin-panel">
              <div className="panel-heading">
                <h3>Low Stock Products</h3>
              </div>
              {renderProducts(lowStockProducts)}
            </div>
          </>
        )}

        {activePage === "Products" && (
          <>
            <div className="admin-toolbar">
              <input
                type="search"
                placeholder="Search products..."
                value={search}
                onChange={(e) => setSearch(e.target.value)}
              />
            </div>

            <div className="admin-panel">
              <div className="panel-heading">
                <h3>All Products ({filteredProducts.length})</h3>
              </div>

              {renderProducts(filteredProducts)}
            </div>
          </>
        )}

        {activePage === "Categories" && (
          <div className="admin-panel">
            <div className="panel-heading">
              <h3>All Categories ({categories.length})</h3>
            </div>

            <div className="table-wrapper">
              <table className="admin-table">
                <thead>
                  <tr>
                    <th>ID</th>
                    <th>Category Name</th>
                    <th>Description</th>
                  </tr>
                </thead>

                <tbody>
                  {categories.map((category) => (
                    <tr key={category.id}>
                      <td>{category.id}</td>
                      <td>{category.name}</td>
                      <td>{category.description || "No description"}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </main>
    </div>
  );
}

export default AdminDashboard;

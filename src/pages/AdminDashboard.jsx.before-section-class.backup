// export default AdminDashboard;


import React, { useCallback, useEffect, useState } from "react";
import "./AdminDashboard.css";

const API_BASE = "https://{127.0.0.1:8000}/api";

const initialProduct = {
  name: "",
  description: "",
  category: "",
  price: "",
  stock: "",
};

const AdminDashboard = () => {
  const token = localStorage.getItem("access_token");

  const [activeSection, setActiveSection] = useState("dashboard");
  const [products, setProducts] = useState([]);
  const [categories, setCategories] = useState([]);
  const [carts, setCarts] = useState([]);
  const [users, setUsers] = useState([]);
  const [orders, setOrders] = useState([]);
  const [payments, setPayments] = useState([]);

  const [loading, setLoading] = useState(false);
  const [search, setSearch] = useState("");

  const [showProductForm, setShowProductForm] = useState(false);
  const [savingProduct, setSavingProduct] = useState(false);
  const [newProduct, setNewProduct] = useState(initialProduct);

  const [imageFile, setImageFile] = useState(null);
  const [imagePreview, setImagePreview] = useState("");

  const [productError, setProductError] = useState("");
  const [productSuccess, setProductSuccess] = useState("");
  const [sectionErrors, setSectionErrors] = useState({});

  // API REQUEST
  const request = async (url, options = {}) => {
    const isFormData = options.body instanceof FormData;

    const headers = {
      ...(token ? { Authorization: `Bearer ${token}` } : {}),
      ...options.headers,
    };

    if (!isFormData) {
      headers["Content-Type"] = "application/json";
    }

    const response = await fetch(`${API_BASE}${url}`, {
      ...options,
      headers,
    });

    const data = await response.json().catch(() => ({}));

    if (!response.ok) {
      const message =
        data.detail ||
        data.error ||
        Object.entries(data)
          .map(([key, value]) => {
            const errorText =
              typeof value === "object"
                ? JSON.stringify(value)
                : String(value);
            return `${key}: ${errorText}`;
          })
          .join("\n") ||
        `Request failed: ${response.status}`;

      throw new Error(message);
    }

    return data;
  };

  // HANDLE API LIST RESPONSES
  const getList = (data) => {
    if (Array.isArray(data)) return data;
    if (Array.isArray(data.results)) return data.results;
    if (Array.isArray(data.data)) return data.data;
    return [];
  };

  // LOAD DASHBOARD DATA
  const loadDashboardData = useCallback(async () => {
    setLoading(true);
    const errors = {};

    const endpoints = [
      { key: "products", url: "/products/", setter: setProducts },
      { key: "categories", url: "/categories/", setter: setCategories },
      { key: "carts", url: "/cart/admin/", setter: setCarts },
      { key: "users", url: "/auth/admin/users/", setter: setUsers },
      { key: "orders", url: "/orders/admin/", setter: setOrders },
      { key: "payments", url: "/payments/admin/", setter: setPayments },
    ];

    await Promise.all(
      endpoints.map(async ({ key, url, setter }) => {
        try {
          const data = await request(url);
          setter(getList(data));
        } catch (error) {
          errors[key] = error.message;
          console.error(`${key} API error:`, error.message);
        }
      })
    );

    setSectionErrors(errors);
    setLoading(false);
  }, [token]);

  useEffect(() => {
    loadDashboardData();
  }, [loadDashboardData]);

  // PRODUCT INPUT CHANGE
  const handleProductChange = (e) => {
    const { name, value } = e.target;

    setNewProduct((previous) => ({
      ...previous,
      [name]: value,
    }));
  };

  // SELECT PRODUCT IMAGE
  const handleImageChange = (e) => {
    const file = e.target.files?.[0];

    if (!file) return;

    if (!file.type.startsWith("image/")) {
      setProductError("Please select a valid image.");
      e.target.value = "";
      return;
    }

    if (file.size > 5 * 1024 * 1024) {
      setProductError("Image size must be less than 5 MB.");
      e.target.value = "";
      return;
    }

    if (imagePreview) {
      URL.revokeObjectURL(imagePreview);
    }

    setImageFile(file);
    setImagePreview(URL.createObjectURL(file));
    setProductError("");
  };

  // REMOVE IMAGE
  const handleRemoveImage = () => {
    if (imagePreview) {
      URL.revokeObjectURL(imagePreview);
    }

    setImageFile(null);
    setImagePreview("");
  };

  // ADD PRODUCT
  const handleAddProduct = async (e) => {
    e.preventDefault();

    setProductError("");
    setProductSuccess("");

    if (
      !newProduct.name.trim() ||
      !newProduct.category ||
      newProduct.price === "" ||
      newProduct.stock === ""
    ) {
      setProductError("Please fill all required fields.");
      return;
    }

    const price = Number(newProduct.price);
    const stock = Number(newProduct.stock);

    if (!Number.isFinite(price) || price <= 0) {
      setProductError("Enter a valid product price.");
      return;
    }

    if (!Number.isInteger(stock) || stock < 0) {
      setProductError("Enter a valid stock quantity.");
      return;
    }

    if (!imageFile) {
      setProductError("Please select a product image.");
      return;
    }

    try {
      setSavingProduct(true);

      const formData = new FormData();

      formData.append("name", newProduct.name.trim());
      formData.append("description", newProduct.description.trim());
      formData.append("category", newProduct.category);
      formData.append("price", String(price));
      formData.append("stock", String(stock));
      formData.append("image", imageFile);

      await request("/products/", {
        method: "POST",
        body: formData,
      });

      setProductSuccess("Product added successfully!");

      setNewProduct(initialProduct);
      handleRemoveImage();
      setShowProductForm(false);

      await loadDashboardData();

      alert("Product added successfully!");
    } catch (error) {
      console.error("Add product error:", error);
      setProductError(error.message);
    } finally {
      setSavingProduct(false);
    }
  };

  // CLOSE PRODUCT FORM
  const closeProductForm = () => {
    setShowProductForm(false);
    setNewProduct(initialProduct);
    setProductError("");
    setProductSuccess("");
    handleRemoveImage();
  };

  // DELETE PRODUCT
  const handleDeleteProduct = async (id) => {
    if (!window.confirm("Are you sure you want to delete this product?")) {
      return;
    }

    try {
      await request(`/products/${id}/`, {
        method: "DELETE",
      });

      setProducts((previous) =>
        previous.filter((product) => product.id !== id)
      );

      alert("Product deleted successfully!");
    } catch (error) {
      alert(error.message);
    }
  };

  // DELETE CATEGORY
  const handleDeleteCategory = async (id) => {
    if (!window.confirm("Delete this category?")) return;

    try {
      await request(`/categories/${id}/`, {
        method: "DELETE",
      });

      setCategories((previous) =>
        previous.filter((category) => category.id !== id)
      );
    } catch (error) {
      alert(error.message);
    }
  };

  // FORMAT CURRENCY
const formatAdminCurrency = (amount) => {
  const value = Number(amount || 0);

  return new Intl.NumberFormat("en-IN", {
    style: "currency",
    currency: "INR",
    maximumFractionDigits: 2,
  }).format(value);
};

// UPDATE ORDER STATUS
const handleOrderStatus = async (id, status) => {
  try {
    await request(`/orders/admin/${id}/status/`, {
      method: "PATCH",
      body: JSON.stringify({ status }),
    });

    await loadDashboardData();
    alert("Order status updated successfully!");
  } catch (error) {
    alert(error.message || "Unable to update order status.");
  }
};

  // FILTER PRODUCTS
  const filteredProducts = products.filter((product) =>
    product.name?.toLowerCase().includes(search.toLowerCase())
  );

  const menuItems = [
    { id: "dashboard", label: "Dashboard" },
    { id: "products", label: "Products" },
    { id: "categories", label: "Categories" },
    { id: "carts", label: "Cart" },
    { id: "users", label: "Users" },
    { id: "orders", label: "Orders" },
    { id: "payments", label: "Payments" },
  ];

  // IMAGE URL
  const getImageUrl = (image) => {
    if (!image) return "";

    if (image.startsWith("http")) {
      return image;
    }

    return `https://{127.0.0.1:8000}${image.startsWith("/") ? "" : "/"}${image}`;
  };

  return (
    <div className="admin-dashboard">
      <aside className="admin-sidebar">
        <h2>Vyntra Admin</h2>

        <nav>
          {menuItems.map((item) => (
            <button
              key={item.id}
              className={
                activeSection === item.id ? "active" : ""
              }
              onClick={() => setActiveSection(item.id)}
            >
              {item.label}
            </button>
          ))}
        </nav>
      </aside>

      <main className="admin-main">
        <header className="admin-header">
          <h2>
            {menuItems.find((item) => item.id === activeSection)?.label}
          </h2>

          <button onClick={loadDashboardData}>
            Refresh Data
          </button>
        </header>

        {loading && <p>Loading dashboard data...</p>}

        {/* DASHBOARD */}
        {activeSection === "dashboard" && (
          <section className="dashboard-content">
            <h2>Dashboard Overview</h2>

            <div className="dashboard-cards">
              <div className="dashboard-card">
                <h3>Total Products</h3>
                <p>{products.length}</p>
              </div>

              <div className="dashboard-card">
                <h3>Categories</h3>
                <p>{categories.length}</p>
              </div>

              <div className="dashboard-card">
                <h3>Users</h3>
                <p>{users.length}</p>
              </div>

              <div className="dashboard-card">
                <h3>Orders</h3>
                <p>{orders.length}</p>
              </div>

              <div className="dashboard-card">
                <h3>Payments</h3>
                <p>{payments.length}</p>
              </div>

              <div className="dashboard-card">
                <h3>Cart Items</h3>
                <p>{carts.length}</p>
              </div>
            </div>
          </section>
        )}

        {/* PRODUCTS */}
        {activeSection === "products" && (
          <section className="admin-section">
            <div className="section-heading">
              <h2>Products Management</h2>

              <button onClick={() => setShowProductForm(true)}>
                + Add Product
              </button>
            </div>

            <input
              type="text"
              placeholder="Search products..."
              value={search}
              onChange={(e) => setSearch(e.target.value)}
            />

            {sectionErrors.products && (
              <p className="error-message">
                {sectionErrors.products}
              </p>
            )}

            {showProductForm && (
              <div className="product-form-container">
                <h3>Add New Product</h3>

                <form onSubmit={handleAddProduct}>
                  <label>Product Name *</label>
                  <input
                    type="text"
                    name="name"
                    value={newProduct.name}
                    onChange={handleProductChange}
                    placeholder="Enter product name"
                    required
                  />

                  <label>Description</label>
                  <textarea
                    name="description"
                    value={newProduct.description}
                    onChange={handleProductChange}
                    placeholder="Enter product description"
                  />

                  <label>Category *</label>
                  <select
                    name="category"
                    value={newProduct.category}
                    onChange={handleProductChange}
                    required
                  >
                    <option value="">Select Category</option>

                    {categories.map((category) => (
                      <option
                        key={category.id}
                        value={category.id}
                      >
                        {category.name}
                      </option>
                    ))}
                  </select>

                  <label>Price *</label>
                  <input
                    type="number"
                    name="price"
                    value={newProduct.price}
                    onChange={handleProductChange}
                    min="0.01"
                    step="0.01"
                    required
                  />

                  <label>Stock *</label>
                  <input
                    type="number"
                    name="stock"
                    value={newProduct.stock}
                    onChange={handleProductChange}
                    min="0"
                    required
                  />

                  <label>Select Product Image *</label>
                  <input
                    type="file"
                    name="image"
                    accept="image/*"
                    onChange={handleImageChange}
                    required
                  />

                  {imagePreview && (
                    <div className="image-preview">
                      <img
                        src={imagePreview}
                        alt="Product Preview"
                        style={{
                          width: "150px",
                          height: "150px",
                          objectFit: "cover",
                          borderRadius: "10px",
                          marginTop: "10px",
                        }}
                      />

                      <button
                        type="button"
                        onClick={handleRemoveImage}
                      >
                        Remove Image
                      </button>
                    </div>
                  )}

                  {productError && (
                    <p className="error-message">{productError}</p>
                  )}

                  {productSuccess && (
                    <p className="success-message">
                      {productSuccess}
                    </p>
                  )}

                  <div className="form-buttons">
                    <button type="submit" disabled={savingProduct}>
                      {savingProduct ? "Saving..." : "Add Product"}
                    </button>

                    <button
                      type="button"
                      onClick={closeProductForm}
                    >
                      Cancel
                    </button>
                  </div>
                </form>
              </div>
            )}

            <div className="products-grid">
              {filteredProducts.map((product) => (
                <div className="product-card" key={product.id}>
                  {product.image && (
                    <img
                      src={getImageUrl(product.image)}
                      alt={product.name}
                      className="product-image"
                    />
                  )}

                  <h3>{product.name}</h3>
                  <p>{product.description}</p>
                  <p>Price: ₹{product.price}</p>
                  <p>Stock: {product.stock}</p>

                  <button
                    onClick={() => handleDeleteProduct(product.id)}
                  >
                    Delete
                  </button>
                </div>
              ))}
            </div>

            {!filteredProducts.length && !loading && (
              <p>No products found.</p>
            )}
          </section>
        )}

        {/* CATEGORIES */}
        {activeSection === "categories" && (
          <section className="admin-section">
            <h2>Categories Management</h2>

            {categories.map((category) => (
              <div className="admin-list-item" key={category.id}>
                <span>{category.name}</span>

                <button
                  onClick={() => handleDeleteCategory(category.id)}
                >
                  Delete
                </button>
              </div>
            ))}

            {!categories.length && <p>No categories found.</p>}
          </section>
        )}

        {/* CART */}
        {activeSection === "carts" && (
          <section className="admin-section">
            <h2>Cart Management</h2>

            {carts.map((cart) => (
              <div className="admin-list-item" key={cart.id}>
                <span>
                  Cart #{cart.id} - User: {cart.user || cart.user_id || "N/A"}
                </span>
              </div>
            ))}

            {!carts.length && <p>No cart items found.</p>}
          </section>
        )}

        {/* USERS */}
        {activeSection === "users" && (
          <section className="admin-section">
            <h2>Users Management</h2>

            {users.map((user) => (
              <div className="admin-list-item" key={user.id}>
                <span>
                  {user.username || user.email || user.id}
                </span>
              </div>
            ))}

            {!users.length && <p>No users found.</p>}
          </section>
        )}

        {/* ORDERS */}
        {activeSection === "orders" && (
          <section className="admin-section">
            <h2>Orders Management</h2>

            {orders.map((order) => (
              <div className="admin-list-item" key={order.id}>
                <span>
                  Order #{order.id} - {order.status || "Pending"}
                </span>

                <select
                  value={order.status || "pending"}
                  onChange={(e) =>
                    handleOrderStatus(order.id, e.target.value)
                  }
                >
                  <option value="pending">Pending</option>
                  <option value="processing">Processing</option>
                  <option value="shipped">Shipped</option>
                  <option value="delivered">Delivered</option>
                  <option value="cancelled">Cancelled</option>
                </select>
              </div>
            ))}

            {!orders.length && <p>No orders found.</p>}
          </section>
        )}

        {/* PAYMENTS */}
        {activeSection === "payments" && (
          <section className="admin-section">
            <h2>Payments Management</h2>

            {payments.map((payment) => (
              <div className="admin-list-item" key={payment.id}>
                <span>
                  Payment #{payment.id} - ₹{payment.amount || "N/A"} -{" "}
                  {payment.status || "N/A"}
                </span>
              </div>
            ))}

            {!payments.length && <p>No payments found.</p>}
          </section>
        )}
      </main>
    </div>
  );
};

export default AdminDashboard;


